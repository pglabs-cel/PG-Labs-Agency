# API & Site Configuration (Same-Origin Serverless API)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=https://pglabs.co.in
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# MongoDB Atlas Connection
MONGODB_URI=your_mongodb_connection_string_here
MONGO_DB_URL=your_mongodb_connection_string_here

# Email Delivery (Gmail SMTP via Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=admin_notifications@example.com
EMAIL_SENDER_NAME=PG Labs

# Admin Authentication
ADMIN_PASSCODE=your_secure_admin_passcode
ADMIN_JWT_SECRET=your_secure_jwt_secret

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare Turnstile Configuration
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET=your_turnstile_secret_key
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,pglabs.co.in,www.pglabs.co.in
