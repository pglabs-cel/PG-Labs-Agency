# Backend API Base URL (e.g. https://api.pglabs.co.in/api or https://pg-labs-backend.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Frontend Site URL (e.g. https://pglabs.co.in or https://pg-labs.vercel.app)
NEXT_PUBLIC_SITE_URL=https://pglabs.co.in

# Suppress SWC lockfile patching warning
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# Cloudflare Turnstile Configuration
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAErHia0FCATonsTD
TURNSTILE_SECRET=your_turnstile_secret_key_here
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,pglabs.co.in,www.pglabs.co.in,pglabs.agency,www.pglabs.agency,pg-labs-agency.vercel.app

