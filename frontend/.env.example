# Backend API Base URL (e.g. https://api.pglabs.agency/api or https://pg-labs-backend.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Frontend Site URL (e.g. https://pglabs.agency or https://pg-labs.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suppress SWC lockfile patching warning
NEXT_IGNORE_INCORRECT_LOCKFILE=1
