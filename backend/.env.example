# Server Port (Render & Railway inject this automatically as PORT)
PORT=5000

# Allowed CORS Origins (comma-separated URLs without trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://pglabs.agency,https://www.pglabs.agency,https://pg-labs-agency.vercel.app

# MongoDB Connection String (MongoDB Atlas)
MONGO_DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# SMTP & Email Notification Settings (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=pglabs.agency@gmail.com
EMAIL_PASS=your_gmail_app_password_here
ADMIN_NOTIFICATION_EMAIL=pglabs.agency@gmail.com
